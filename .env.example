# Segredos usados somente pelo backend. Nunca use o prefixo EXPO_PUBLIC nestes valores.
GEMINI_API_KEY=sua_chave_do_google_ai_studio
GEMINI_MODEL=gemini-3.6-flash
# E-mail de recuperação de senha (https://resend.com). RESEND_FROM precisa usar um domínio verificado no Resend.
RESEND_API_KEY=
RESEND_FROM=CaloriQ <nao-responda@seu-dominio.com>
# Fotos de evolução na nuvem (Supabase Storage). Use um bucket PRIVADO. A service role key é secreta: só no backend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PHOTOS_BUCKET=progress-photos
# Somente desenvolvimento: mostra no console o e-mail que seria enviado quando não há RESEND_API_KEY.
MAIL_DEV_LOG=false
# true = não chama o Gemini e garante uma demonstração totalmente local
EXPO_PUBLIC_AI_DEMO_MODE=false

# Aplicativo: use "auto" no desenvolvimento local ou a URL HTTPS do Render no APK.
EXPO_PUBLIC_API_URL=auto
EXPO_PUBLIC_API_PORT=3333
# Mostra diagnóstico e configuração de apresentação somente em builds internos.
EXPO_PUBLIC_DEV_TOOLS=false
# Backend e PostgreSQL local. Na nuvem, configure DATABASE_URL no painel do Render.
DATABASE_URL=postgresql://postgres:troque_esta_senha@localhost:5432/caloriq
API_PORT=3333
